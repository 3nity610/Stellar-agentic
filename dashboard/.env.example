# Dashboard configuration.
#
# Copy to `.env.local` (gitignored) and fill in. Every value here is read at
# **build** time by Vite and inlined into the JavaScript bundle — which is
# exactly why there is no secret in this file. See the note on
# VITE_STELLARAGENT_VIEWER_KEY below.
#
# `scripts/setup.sh` does not check any of this; it checks the toolchain. The
# dashboard itself reports what is missing, as a checklist, on first load.

# ─── Which data source ───────────────────────────────────────────────────────
#
# `mock` serves fixtures from src/lib/mockData.ts. `chain` (the default) reads
# real state. There is no third option and no implicit fallback: a dashboard
# that quietly serves fixtures while claiming to be connected is worse than
# one that shows nothing.
#
# The runtime switch — the badge in the sidebar, and `?mode=mock` on the URL —
# overrides this. In CI the e2e suite builds with VITE_STELLARAGENT_MODE=mock
# (see playwright.config.ts), which is the only way it can run without a
# deployed network.
VITE_STELLARAGENT_MODE=chain

# ─── Network and contracts ───────────────────────────────────────────────────
#
# mainnet | testnet | local. The contract variables are read network-scoped
# first, then unscoped, exactly like `resolveContracts` in @stellaragent/core —
# so the same `STELLARAGENT_TESTNET_PAYMENT_CHANNEL=…` values that
# `pnpm deploy:contracts` prints work here unchanged.
#
# Only `PAYMENT_CHANNEL` and `ESCROW` are required; no built panel calls the
# circuit breaker or the agent wallet factory, and a setup checklist padded
# with addresses nobody asked for is a checklist people stop reading.
VITE_STELLARAGENT_NETWORK=testnet
VITE_STELLARAGENT_TESTNET_PAYMENT_CHANNEL=C...
VITE_STELLARAGENT_TESTNET_ESCROW=C...

# Friendly asset code -> token contract id, for display.
# VITE_STELLARAGENT_ASSET_CONTRACTS={"USDC":"C..."}

# ─── The account transactions are built from ──────────────────────────────────
#
# NOT a secret, and deliberately not a secret key. The dashboard only ever
# makes read-only calls, and read-only calls never sign — but Soroban
# simulation still needs a source account, so one has to be named. Point this
# at any funded G... account you do not mind transactions being built from.
#
# Do not put an S... key in a VITE_ variable. Vite inlines these values into
# the bundle, which is served to every visitor.
VITE_STELLARAGENT_VIEWER_KEY=G...

# ─── What to watch ───────────────────────────────────────────────────────────
#
# The contracts are keyed by ID and have no "list every channel" query, so the
# dashboard needs a roster. It is configuration, not discovery.
VITE_STELLARAGENT_AGENTS=[{"id":"inference","name":"Inference Agent","address":"G...","channelId":"1","asset":"USDC"}]
VITE_STELLARAGENT_JOBS=[{"id":"7","workerName":"Summarizer Bot"}]

# ─── Payment feed ────────────────────────────────────────────────────────────
#
# @stellaragent/indexer's query API. The payment feed and the spend chart are
# the only things that need it; the agent and job panels work without it.
# Start the indexer with: pnpm --filter @stellaragent/indexer dev
VITE_STELLARAGENT_INDEXER_URL=http://localhost:8787

# ─── Tuning ──────────────────────────────────────────────────────────────────
#
# Panel poll interval, in milliseconds. Minimum 1000.
VITE_STELLARAGENT_POLL_MS=15000
