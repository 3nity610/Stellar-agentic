#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Pre-commit hook for StellarAgent
# Runs fast formatting/linting checks on staged files
# Full test runs are left to CI

echo "Running pre-commit checks..."

# Check TypeScript/JavaScript files with lint-staged
pnpm lint-staged

# Check Rust formatting on staged .rs files
STAGED_RS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)
if [ -n "$STAGED_RS_FILES" ]; then
  echo "Checking Rust formatting on staged files..."
  echo "$STAGED_RS_FILES" | xargs -r cargo fmt --check --
fi

# Check Python formatting on staged .py files
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
if [ -n "$STAGED_PY_FILES" ]; then
  echo "Checking Python formatting on staged files..."
  echo "$STAGED_PY_FILES" | xargs -r ruff check --fix
  echo "$STAGED_PY_FILES" | xargs -r ruff format --check
fi
